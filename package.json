{
  "name": "spoton",
  "version": "2.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "sw:build": "node scripts/build-sw.mjs",
    "predev": "npm run sw:build",
    "dev": "next dev",
    "prebuild": "npm run sw:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "functions:build": "cd functions && npm run build",
    "functions:deploy": "firebase deploy --only functions",
    "functions:logs": "firebase functions:log",
    "pretypecheck": "npm run sw:build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:fn": "npm --prefix functions run build && npm --prefix functions run lint && npm --prefix functions test",
    "test:e2e": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,storage,functions --project demo-spoton \"tsx scripts/seed-emulator.ts && playwright test\"",
    "store:assets": "firebase emulators:exec --only auth,firestore,storage --project demo-spoton \"tsx scripts/store/seed-demo.ts && playwright test -c playwright.store.config.ts\"",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-spoton \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.3",
    "browser-image-compression": "^2.0.2",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "lucide-react": "1.50.0",
    "mapbox-gl": "3.32.0",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supercluster": "9.1.0",
    "typescript": "6.0.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.32.1",
    "postcss": "^8.4.38",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    }
  }
}
