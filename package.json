{
  "name": "spoton",
  "version": "2.0.2",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "functions:build": "cd functions && npm run build",
    "functions:deploy": "firebase deploy --only functions",
    "functions:logs": "firebase functions:log",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:fn": "npm --prefix functions run build && npm --prefix functions run lint && npm --prefix functions test",
    "test:e2e": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,storage,functions --project demo-spoton \"tsx scripts/seed-emulator.ts && playwright test\"",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-spoton \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@types/leaflet": "1.9.22",
    "browser-image-compression": "^2.0.2",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "nodemailer": "10.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "typescript": "6.0.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.32.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
