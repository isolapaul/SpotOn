rules_version = '2';

// SpotOn Firestore rules (T12). The real authorization boundary: UI checks are UX only.
// Server-only data (publicProfiles, usernames, admins, users.{username, customName*, highlightedSpots,
// quest*, spotsCount, xp, level, levelFloor, pinIcon}, spots.{highlighted, isHighlighted,
// contributors, ownerPin, spotImages likes/additions}) is written by Cloud Functions through the
// Admin SDK, which bypasses these rules.
// Rules do not filter queries: every client query must be provably allowed (T30 spots), or it fails
// for everyone.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // ---------- spots ----------
    function validLocation(l) {
      return l is map && l.keys().hasOnly(['lat', 'lng']) && l.keys().hasAll(['lat', 'lng'])
        && l.lat is number && l.lat >= -90 && l.lat <= 90
        && l.lng is number && l.lng >= -180 && l.lng <= 180;
    }
    function builtInCategory(c) {
      return c in ['scenic', 'smoke-spot', 'viewpoint', 'other', 'hiking', 'random', 'date-spot', 'park', 'part'];
    }
    // Item 7: a built-in category or one the super admin created (categories/{id}).
    function validCategory(c) {
      return c is string && (builtInCategory(c)
        || (c.size() >= 1 && c.size() <= 100 && exists(/databases/$(database)/documents/categories/$(c))));
    }
    function validSpotCreate() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['name', 'category', 'description', 'location', 'createdBy', 'createdByName',
                             'createdByPhoto', 'imageUrls', 'spotImages', 'primaryImageIndex', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'category', 'description', 'location', 'createdBy',
                            'imageUrls', 'spotImages', 'primaryImageIndex', 'status', 'createdAt'])
        && d.createdBy == request.auth.uid
        && (d.status == 'pending' || (d.status == 'approved' && isAdmin()))
        && d.createdAt == request.time
        && isStr(d.name, 1, 100)
        && d.description is string && d.description.size() <= 2000
        && validCategory(d.category)
        && validLocation(d.location)
        && (!('createdByName' in d) || isStr(d.createdByName, 0, 100))
        && (!('createdByPhoto' in d) || isStr(d.createdByPhoto, 0, 2048))
        && d.imageUrls is list && d.imageUrls.size() >= 1 && d.imageUrls.size() <= 20
        && d.spotImages is list && d.spotImages.size() <= 20
        && d.primaryImageIndex is int && d.primaryImageIndex >= 0 && d.primaryImageIndex < d.imageUrls.size();
    }
    // New reviews carry no PII and no self-asserted badges (SEC-03, SEC-05).
    function validNewReview(r) {
      return r is map
        && r.keys().hasOnly(['id', 'userId', 'userName', 'userPhoto', 'rating', 'comment', 'createdAt'])
        && r.keys().hasAll(['id', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && r.userId == request.auth.uid
        && r.id is string && r.id.matches(request.auth.uid + '_[0-9]+')
        && isStr(r.userName, 1, 100)
        && (!('userPhoto' in r) || isStr(r.userPhoto, 0, 2048))
        && r.rating is int && r.rating >= 1 && r.rating <= 5
        && r.comment is string && r.comment.size() <= 1000
        && r.createdAt is timestamp && r.createdAt <= request.time + duration.value(5, 'm');
    }
    // Exactly one review appended; existing (incl. legacy) entries untouched and in order.
    // Approved spots only: a pending spot is not reviewable (and a write must not reveal that a pending id exists).
    function isReviewAppend() {
      let oldR = resource.data.get('reviews', []);
      let newR = request.resource.data.get('reviews', []);
      return signedIn()
        && resource.data.status == 'approved'
        && changed().hasOnly(['reviews'])
        && newR is list
        && newR.size() == oldR.size() + 1
        // an empty slice list[0:0] raises an index error in the rules runtime, so guard it
        && (oldR.size() == 0 || newR[0:oldR.size()] == oldR)
        && validNewReview(newR[oldR.size()]);
    }
    function onlyRemoved(oldL, newL) {
      return newL is list && newL.size() <= oldL.size() && newL.removeAll(oldL).size() == 0;
    }
    // Owner image edits may only remove entries (SEC-10); removing the last one leaves the placeholder.
    // Used for spots under review (isOwnerDraftEdit).
    function validOwnerImages() {
      let newU = request.resource.data.get('imageUrls', []);
      return (newU == ['/placeholder-spot.jpg'] || onlyRemoved(resource.data.get('imageUrls', []), newU))
        && onlyRemoved(resource.data.get('spotImages', []), request.resource.data.get('spotImages', []));
    }
    // Item 4: the owner edits a spot still under review (pending) or rejected, and may resubmit a
    // rejected one: status rejected → pending, with the rejection removed. Photos: removals here;
    // additions go through addSpotImages (direct for the owner of a spot under review).
    function isOwnerDraftEdit() {
      let d = request.resource.data;
      let ak = changed();
      let st = resource.data.status;
      return signedIn()
        && resource.data.createdBy == request.auth.uid
        && st in ['pending', 'rejected']
        && ak.hasOnly(['name', 'description', 'category', 'location', 'primaryImageIndex', 'imageUrls', 'spotImages',
                       'status', 'rejection'])
        && (!ak.hasAny(['name']) || isStr(d.name, 1, 100))
        && (!ak.hasAny(['description']) || (d.description is string && d.description.size() <= 2000))
        && (!ak.hasAny(['category']) || validCategory(d.category))
        && (!ak.hasAny(['location']) || validLocation(d.location))
        && (!ak.hasAny(['primaryImageIndex']) || (d.primaryImageIndex is int && d.primaryImageIndex >= 0
            && d.primaryImageIndex < d.get('imageUrls', []).size()))
        && (!ak.hasAny(['imageUrls', 'spotImages']) || validOwnerImages())
        && (!ak.hasAny(['status']) || (st == 'rejected' && d.status == 'pending' && !('rejection' in d)))
        && (!ak.hasAny(['rejection']) || (d.status == 'pending' && !('rejection' in d)));
    }
    function isAdminEdit() {
      return isAdmin() && !changed().hasAny(['status', 'rejection', 'createdBy', 'contributors', 'ownerPin']);
    }
    match /spots/{spotId} {
      // Replies to reviews (questions and answers): on approved spots, by signed-in users; the author
      // edits the text or deletes, admins delete through reports (Cloud Functions).
      match /replies/{replyId} {
        function spotVisible() {
          return get(/databases/$(database)/documents/spots/$(spotId)).data.status == 'approved';
        }
        allow read: if spotVisible() || isAdmin();
        allow create: if signedIn() && spotVisible()
          && request.resource.data.keys().hasOnly(['reviewId', 'userId', 'text', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && isStr(request.resource.data.reviewId, 1, 200)
          && isStr(request.resource.data.text.trim(), 1, 500)
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && resource.data.userId == request.auth.uid
          && changed().hasOnly(['text', 'editedAt'])
          && isStr(request.resource.data.text.trim(), 1, 500)
          && request.resource.data.editedAt == request.time;
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
      // T30: pending spots only for their owner and admins. Rules are not filters: the client queries
      // status == 'approved', createdBy == uid, or (admins) everything.
      allow read: if resource.data.status == 'approved'
                  || (request.auth != null && resource.data.createdBy == request.auth.uid)
                  || isAdmin();
      allow create: if validSpotCreate();
      // An owner's change to an approved spot is a proposal (spotEdits) since item 4. Approving,
      // rejecting (with a reason) and removing go through the moderation callables, so admins edit
      // fields and photos here but never the status, and nobody deletes a spot directly.
      allow update: if isAdminEdit() || isReviewAppend() || isOwnerDraftEdit();
      allow delete: if false;
    }

    // ---------- users ----------
    function userClientKeys() {
      return ['uid', 'email', 'photoURL', 'profilePictureURL', 'profileBannerURL', 'savedSpots', 'fcmTokens',
              'language', 'notificationsEnabled', 'notificationSettings', 'lastTokenUpdate', 'lastLoginAt', 'createdAt',
              'termsVersion', 'termsAcceptedAt', 'bio', 'profilePrivate', 'showSaved'];
    }
    function validNotifSettings(s) {
      return s is map && s.keys().hasOnly(['spotApproved', 'spotReviewed', 'newPendingSpot', 'follows'])
        && (!('follows' in s) || s.follows is bool)
        && (!('spotApproved' in s) || s.spotApproved is bool)
        && (!('spotReviewed' in s) || s.spotReviewed is bool)
        && (!('newPendingSpot' in s) || s.newPendingSpot is bool);
    }
    // A list may exceed its cap only while it shrinks, so legacy oversized lists can still be trimmed.
    function withinCapOrShrinking(list, field, cap) {
      return list.size() <= cap
        || (resource != null && list.size() < resource.data.get(field, []).size());
    }
    function validUserFields(d, ak) {
      return (!ak.hasAny(['uid']) || d.uid == request.auth.uid)
        && (!ak.hasAny(['email']) || d.email == '' || d.email == request.auth.token.get('email', ''))
        && (!ak.hasAny(['photoURL']) || isStr(d.photoURL, 0, 2048))
        && (!ak.hasAny(['profilePictureURL']) || isStr(d.profilePictureURL, 0, 2048))
        && (!ak.hasAny(['profileBannerURL']) || isStr(d.profileBannerURL, 0, 2048))
        && (!ak.hasAny(['savedSpots']) || (d.savedSpots is list && withinCapOrShrinking(d.savedSpots, 'savedSpots', 1000)))
        && (!ak.hasAny(['fcmTokens']) || (d.fcmTokens is list && withinCapOrShrinking(d.fcmTokens, 'fcmTokens', 100)))
        && (!ak.hasAny(['language']) || d.language in ['hu', 'en', 'de'])
        && (!ak.hasAny(['notificationsEnabled']) || d.notificationsEnabled is bool)
        && (!ak.hasAny(['notificationSettings']) || validNotifSettings(d.notificationSettings))
        && (!ak.hasAny(['lastTokenUpdate']) || isStr(d.lastTokenUpdate, 0, 64))
        && (!ak.hasAny(['lastLoginAt']) || d.lastLoginAt == request.time)
        && (!ak.hasAny(['createdAt']) || d.createdAt == request.time)
        // Terms acceptance (A1): the version string and the server time of the acceptance.
        && (!ak.hasAny(['termsVersion']) || isStr(d.termsVersion, 1, 32))
        && (!ak.hasAny(['termsAcceptedAt']) || d.termsAcceptedAt == request.time)
        // Item 8: the bio, a private profile, saved spots shown on the profile.
        && (!ak.hasAny(['bio']) || isStr(d.bio, 0, 150))
        && (!ak.hasAny(['profilePrivate']) || d.profilePrivate is bool)
        && (!ak.hasAny(['showSaved']) || d.showSaved is bool);
    }
    match /users/{userId} {
      allow get: if isSelf(userId);
      allow list: if false;
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(userClientKeys())
        && validUserFields(request.resource.data, request.resource.data.keys());
      allow update: if isSelf(userId)
        && changed().hasOnly(userClientKeys())
        && validUserFields(request.resource.data, changed());
      allow delete: if false;

      // The user's own spot lists; the profile shows the shared ones through getProfile.
      match /lists/{listId} {
        function validList(d) {
          return d.keys().hasOnly(['name', 'spotIds', 'shared', 'createdAt', 'updatedAt'])
            && isStr(d.name.trim(), 1, 50) && d.spotIds is list && d.spotIds.size() <= 200
            && d.shared is bool && d.updatedAt == request.time;
        }
        allow read, delete: if isSelf(userId);
        allow create: if isSelf(userId) && validList(request.resource.data) && request.resource.data.createdAt == request.time;
        allow update: if isSelf(userId) && validList(request.resource.data) && !changed().hasAny(['createdAt']);
      }
    }

    // ---------- moderation (item 4) ----------
    // The owner's proposed edit of an approved spot: one per spot (the doc id), reviewed by an admin
    // (reviewSpotEdit). The owner writes it whole (a new proposal replaces a rejected one) and may
    // withdraw it; the status and the rejection are set only by the callable.
    function validProposal(p) {
      return p is map && p.size() > 0
        && p.keys().hasOnly(['name', 'description', 'category', 'location', 'removeImageUrls', 'primaryImageUrl'])
        && (!('name' in p) || isStr(p.name, 1, 100))
        && (!('description' in p) || (p.description is string && p.description.size() <= 2000))
        && (!('category' in p) || validCategory(p.category))
        && (!('location' in p) || validLocation(p.location))
        && (!('removeImageUrls' in p) || (p.removeImageUrls is list && p.removeImageUrls.size() <= 20))
        && (!('primaryImageUrl' in p) || isStr(p.primaryImageUrl, 1, 2048));
    }
    match /spotEdits/{spotId} {
      function ownSpot() {
        let spot = get(/databases/$(database)/documents/spots/$(spotId)).data;
        return spot.createdBy == request.auth.uid && spot.status == 'approved';
      }
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update: if signedIn()
        && (resource == null || resource.data.ownerId == request.auth.uid)
        && request.resource.data.keys().hasOnly(['spotId', 'spotName', 'ownerId', 'status', 'proposed', 'createdAt'])
        && request.resource.data.keys().hasAll(['spotId', 'spotName', 'ownerId', 'status', 'proposed', 'createdAt'])
        && request.resource.data.spotId == spotId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && isStr(request.resource.data.spotName, 1, 100)
        && validProposal(request.resource.data.proposed)
        && ownSpot();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    // Photos waiting for approval: created and resolved only by the callables.
    match /photoSubmissions/{submissionId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uploader == request.auth.uid);
      allow write: if false;
    }
    // The in-app inbox: written by Cloud Functions; its owner reads it, marks items read, clears them.
    match /users/{userId}/inbox/{itemId} {
      allow get, list: if isSelf(userId);
      allow update: if isSelf(userId) && changed().hasOnly(['read']) && request.resource.data.read is bool;
      allow delete: if isSelf(userId);
      allow create: if false;
    }

    // ---------- server-maintained ----------
    // get only: the client never lists these, and a public list would enumerate admins (isAdmin) and all usernames.
    // The searchUsers callable (item 8) is the controlled exception: signed in, 2+ character prefix, 10 results
    // (username, picture, level, isPrivate), 20 searches a minute per user.
    match /publicProfiles/{uid} { allow get: if true; allow list, write: if false; }
    match /usernames/{name}     { allow get: if true; allow list, write: if false; }
    match /admins/{adminId} {
      allow get: if isSelf(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
    // ---------- follows (item 8) ----------
    // Written only by the follow callables; each side reads its own (the lists are never shown).
    match /follows/{id} {
      allow get, list: if signedIn()
        && (resource.data.follower == request.auth.uid || resource.data.target == request.auth.uid);
      allow write: if false;
    }
    match /followRequests/{id} {
      allow get, list: if signedIn()
        && (resource.data.requester == request.auth.uid || resource.data.target == request.auth.uid);
      allow write: if false;
    }

    // ---------- reports and blocks (Play UGC) ----------
    // Written only by the callables. Admins read the reports; the reported user never does.
    match /reports/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // A block is read only by its blocker (the blocked user is not told).
    match /blocks/{id} {
      allow get, list: if signedIn() && resource.data.blocker == request.auth.uid;
      allow write: if false;
    }

    // ---------- categories (item 7) ----------
    function isSuperAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'super';
    }
    // The hand-drawn icon set (src/lib/categoryIcons.ts, parity-tested).
    function validCategoryIcon(i) {
      return i in ['waterfall', 'lake', 'beach', 'forest', 'cave', 'castle', 'ruins', 'bridge',
                   'church', 'museum', 'cafe', 'food', 'camping', 'picnic', 'bike', 'street-art'];
    }
    // Hungarian name required; English and German optional (they fall back to it).
    function validCategoryDoc(d) {
      return isStr(d.name, 1, 50) && validCategoryIcon(d.icon)
        && (!('nameEn' in d) || isStr(d.nameEn, 1, 50))
        && (!('nameDe' in d) || isStr(d.nameDe, 1, 50));
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['name', 'nameEn', 'nameDe', 'icon', 'createdAt'])
        && validCategoryDoc(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // Rename and icon change (a legacy emoji icon must be replaced then).
      allow update: if isSuperAdmin()
        && changed().hasOnly(['name', 'nameEn', 'nameDe', 'icon', 'updatedAt'])
        && validCategoryDoc(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // Only through the deleteCategory callable, which checks that nothing uses it.
      allow delete: if false;
    }
    // everything else (incl. legacy favorites, reviews, notifications): denied (no match)
  }
}
