rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is Super Admin
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'isolapaul100@gmail.com';
    }
    
    // Helper function to check if user is any admin (Super Admin OR regular admin)
    function isAdmin() {
      return isSuperAdmin() || 
             (request.auth != null && 
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Spots collection
    match /spots/{spotId} {
      // Anyone can read approved spots OR spots without status field (old spots)
      // Admins can read all spots (including pending)
      allow read: if (resource.data.status == null) ||  // Old spots without status field
                     (resource.data.status == 'approved') || 
                     isAdmin();
      
      // Any authenticated user can create spots
      allow create: if isAuthenticated();
      
      // Admins can update any spot (for approval and other admin actions)
      // Authenticated users can update spots to add reviews
      allow update: if isAdmin() || 
                      (isAuthenticated() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews']));
      
      // Only admins can delete spots
      allow delete: if isAdmin();
    }
    
    // Users collection (for user profiles)
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read any profile
      allow read: if isAuthenticated() && 
                    (request.auth.uid == userId || isAdmin());
      
      // Users can create/update their own profile
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      
      // Only admins can delete users
      allow delete: if isAdmin();
      
      // Super Admin can search all users
      allow list: if isSuperAdmin();
    }
    
    // Admins collection (for admin management)
    match /admins/{adminId} {
      // Anyone can read the list of admins (for client-side admin checks)
      allow read: if true;
      
      // Only Super Admin can create/update/delete admins
      allow create, update, delete: if isSuperAdmin();
      
      // Allow listing all admins for client-side caching
      allow list: if true;
    }
  }
}
