rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. SEGÉDFÜGGVÉNYEK ---
    
    function isSuperAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'isolapaul100@gmail.com';
    }
    
    function isRegularAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isSuperAdmin() || isRegularAdmin();
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    // --- 2. SZABÁLYOK ---

    // HELYEK (SPOTS)
    match /spots/{spotId} {
      // Olvasás: Mindenki
      allow read: if true;
      
      // Létrehozás: Bárki, aki be van jelentkezve
      allow create: if isAuthenticated();
      
      // Módosítás (UPDATE):
      // 1. Admin: Bármit módosíthat
      // 2. Tulajdonos: Bármit módosíthat (kivéve státuszt, ha nagyon szigorúak akarunk lenni, de most hagyjuk)
      // 3. Bárki más (pl. kommentelő/értékelő): Módosíthat, DE...
      //    - A státusz nem változhat (request.resource.data.status == resource.data.status)
      //    - A tulajdonos nem változhat (request.resource.data.createdBy == resource.data.createdBy)
      allow update: if isAuthenticated() && (
        isAdmin() || 
        request.auth.uid == resource.data.createdBy ||
        (
          // Ez a rész engedi a "sima" usereknek a kommentelést/értékelést
          request.resource.data.status == resource.data.status && 
          request.resource.data.createdBy == resource.data.createdBy
        )
      );
      
      // Törlés: Csak Admin vagy Tulajdonos
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy || 
        isSuperAdmin()
      );
    }
    
    // KOMMENTEK (Ha külön gyűjteményben vannak)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
    }

    // FELHASZNÁLÓK
    match /users/{userId} {
      allow read: if isAuthenticated() && 
                    (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // ADMINOK
    match /admins/{adminId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if false;
    }
  }
}