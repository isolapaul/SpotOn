<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <!-- Gradient Background -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#334155;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bgGradient)"/>
  
  <!-- Icon -->
  <g transform="translate(400, 250)">
    <!-- Camera icon -->
    <rect x="-60" y="-30" width="120" height="80" rx="10" fill="#475569" stroke="#64748b" stroke-width="4"/>
    <circle cx="0" cy="10" r="25" fill="#334155" stroke="#64748b" stroke-width="3"/>
    <circle cx="0" cy="10" r="15" fill="#475569"/>
    <rect x="25" y="-20" width="20" height="10" rx="3" fill="#475569"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="380" font-family="Arial, sans-serif" font-size="24" fill="#94a3b8" text-anchor="middle" font-weight="bold">
    No Image Provided
  </text>
  <text x="400" y="420" font-family="Arial, sans-serif" font-size="16" fill="#64748b" text-anchor="middle">
    SpotOn Location
  </text>
</svg>
